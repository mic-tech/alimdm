# Copy to .env and fill in. NEVER commit the real .env.
# Your public domain for the cloud (must point to the VPS IP via DNS A/AAAA record)
CLOUD_DOMAIN=cloud.yourdomain.com
# Base URL the devices will call (must be HTTPS)
ALIMDM_BASE_URL=https://cloud.yourdomain.com
# Strong random secret for signing operator JWTs
ALIMDM_SECRET=
# Enroll token devices present at /api/v1/devices/enroll/ (keep secret)
ALIMDM_ENROLL_TOKEN=
# SHA-256 of the APK's *signing certificate*, url-safe base64 without padding.
# QR enrollment refuses to produce a code without it, because a wrong or missing
# checksum fails on the tablet only after the whole APK has downloaded and looks
# like a network fault. Get it with:
#   apksigner verify --print-certs app-release.apk
ALIMDM_PROVISION_CHECKSUM=
# Optional. Stamped into the QR payload so a scanned tablet knows whose it is.
ALIMDM_ORG_ID=

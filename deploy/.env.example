# Copy to .env and fill in. NEVER commit the real .env.
# Your public domain for the cloud (must point to the VPS IP via DNS A/AAAA record)
CLOUD_DOMAIN=cloud.yourdomain.com
# Base URL the devices will call (must be HTTPS)
FK_BASE_URL=https://cloud.yourdomain.com
# Strong random secret for signing operator JWTs
FK_SECRET=
# Enroll token devices present at /api/v1/devices/enroll/ (keep secret)
FK_ENROLL_TOKEN=

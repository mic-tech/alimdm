# Copy to enroll.env (gitignored) and fill in.
# enroll.env holds a live enrolment token — never commit it.
APK=/path/to/ali-mdm/apk/alimdm-release.apk
CLOUD_URL=https://mdm.example.com
ENROLL_TOKEN=
ORG_ID=your-org
# Settings PIN for the kiosk. Required: the app demands one the first time it is
# configured over ADB, and re-uses it to authorise later ADB config.
KIOSK_PIN=
# Optional: ssh target for the cloud host, used only in a closing hint.
SERVER_SSH=user@your-cloud-host
